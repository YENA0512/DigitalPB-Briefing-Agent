# 이 파일은 양식이다. 실제 키는 .env 에 넣고 .env 는 커밋하지 않는다.


OPENAI_API_KEY=sk-proj-xxxx

LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

FMP_API_KEY=xxxx

# 교육과정 노트북 실측 기준 모델 (gpt-4o-mini / gpt-5-mini / gpt-5.5 사용)
OPENAI_MODEL=gpt-5.5
OPENAI_EMBED_MODEL=text-embedding-3-small

# false 면 API 키 없이 전체 흐름이 돈다. 발표장 안전망이므로 끝까지 유지할 것
USE_LLM=false

# 생성 문구 길이. 41케이스 원본 제한(13~74자)은 폴백 문구에만 적용된다
ADVICE_MIN_LEN=40
ADVICE_MAX_LEN=220
ADVICE_MAX_SENTENCES=6
